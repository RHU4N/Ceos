# URLs das APIs acessadas pelo navegador durante o desenvolvimento local.
REACT_APP_API_MATH_URL=http://localhost:8080
REACT_APP_API_LOGIN_URL=http://localhost:8081

# Na Vercel, use /api/login. O vercel.json encaminha a requisição ao Azure
# sem transformar a sessão em cookie de terceiro.

# Builds de produção exigem ambos os destinos explícitos.
# REACT_APP_MATH_API_URL é compatibilidade legada; prefira REACT_APP_API_MATH_URL.
# Nunca use REACT_APP_ para senhas, chaves ou tokens.
