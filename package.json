    "framer-motion": "^12.23.24",
    "jwt-decode": "^4.0.0",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.12.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
